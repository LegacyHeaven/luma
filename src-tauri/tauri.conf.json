{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LUMA",
  "version": "2.10.2",
  "identifier": "dev.luma.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "LUMA",
        "url": "index.html",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "center": true,
        "visible": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Luma contributors",
    "category": "Utility",
    "shortDescription": "The open-source spotlight for the desktop.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
